# .gitignore repositori penelitian rice_yolo (YOLOv8 vs YOLO11, deteksi penyakit daun padi).
# Prinsip: yang masuk hanya kode, konfigurasi, dokumentasi, manifest/daftar split kecil, tabel/grafik hasil kecil, dan sumber paper.
# Dataset, hasil training, bobot model, lingkungan Python, foto dataset, dan bahan pribadi TIDAK masuk.

# ---------------------------------------------------------------- Python / Jupyter
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
.venv/
venv/
env/

# ---------------------------------------------------------------- LaTeX (hasil kompilasi)
*.aux
*.log
*.bbl
*.blg
*.out
*.synctex.gz
*.toc
*.fls
*.fdb_latexmk
/paper/*.pdf
/paper/final/*.pdf
/paper/arsip/*.pdf

# ---------------------------------------------------------------- OS dan editor
Thumbs.db
.DS_Store
desktop.ini
.vscode/
.idea/

# ---------------------------------------------------------------- rahasia
.env
.env.*
*.key
*.pem
secrets.toml

# ---------------------------------------------------------------- bobot model (unduh/latih ulang; lihat README)
*.pt
*.pth
*.onnx
*.engine
*.safetensors
*.ckpt

# ---------------------------------------------------------------- folder besar atau bukan bagian repositori
/runs/
/weights/
/tools/
/bahan_presentasi/
/bahan_bimbingan/
/bahan_bimbingan_v9/
/_prototipe_app_v9/
/_sinkron_tilik_padi/
/skripsi/

